<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Player Settings"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Video Quality -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Video Quality"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinner_quality"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="16dp" />

            <!-- Subtitle Track -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Subtitle Track"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinner_subtitle_track"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="16dp" />

            <!-- Subtitle Size -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="T  Size"
                    android:textColor="#D3D3D3"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_size_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="#9018FF"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekbar_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:progressTint="#3D3D48"
                android:thumbTint="#3D3D48"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:layout_marginBottom="24dp">

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_size_75"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_btn_dark"
                    android:text="75%"
                    android:textAllCaps="false"
                    android:textColor="#888899"
                    android:textSize="12sp" />

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_size_100"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_btn_dark"
                    android:text="100%"
                    android:textAllCaps="false"
                    android:textColor="#888899"
                    android:textSize="12sp" />

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_size_125"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_btn_dark"
                    android:text="125%"
                    android:textAllCaps="false"
                    android:textColor="#888899"
                    android:textSize="12sp" />

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_size_150"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_dark"
                    android:text="150%"
                    android:textAllCaps="false"
                    android:textColor="#888899"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Subtitle Delay / Sync -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⏱  Subtitle Sync"
                    android:textColor="#D3D3D3"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_delay_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Synced"
                    android:textColor="#D3D3D3"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_sync_minus_01"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:text="-0.1s"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#D3D3D3"
                    android:background="@drawable/bg_btn_dark" />

                <SeekBar
                    android:id="@+id/seekbar_delay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="#3D3D48"
                    android:thumbTint="#3D3D48"
                    android:layout_marginHorizontal="8dp" />

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_sync_plus_01"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:text="+0.1s"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#D3D3D3"
                    android:background="@drawable/bg_btn_dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="5"
                android:layout_marginBottom="24dp">

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_sync_minus_1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="-1s"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#888899"
                    android:background="@drawable/bg_btn_dark" />

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_sync_minus_05"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="-0.5s"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#888899"
                    android:background="@drawable/bg_btn_dark" />

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_sync_reset"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Reset"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_purple" />

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_sync_plus_05"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="+0.5s"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#888899"
                    android:background="@drawable/bg_btn_dark" />

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_sync_plus_1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="+1s"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#888899"
                    android:background="@drawable/bg_btn_dark" />
            </LinearLayout>

            <!-- Subtitle Color -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Text Color"
                android:textColor="#D3D3D3"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:id="@+id/color_white_container"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:padding="4dp"
                    android:background="@drawable/bg_color_selected">
                    <View
                        android:id="@+id/color_white"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/circle_white" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/color_yellow_container"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:padding="4dp">
                    <View
                        android:id="@+id/color_yellow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/circle_yellow" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/color_cyan_container"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:padding="4dp">
                    <View
                        android:id="@+id/color_cyan"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/circle_cyan" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/color_green_container"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="4dp">
                    <View
                        android:id="@+id/color_green"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/circle_green" />
                </FrameLayout>
            </LinearLayout>

            <!-- Subtitle Edge Style -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edge Style"
                android:textColor="#D3D3D3"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_edge_outline"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_btn_purple"
                    android:text="Outline"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <Button
                    app:backgroundTint="@null"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:singleLine="true"
                    android:id="@+id/btn_edge_shadow"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_dark"
                    android:text="Shadow"
                    android:textAllCaps="false"
                    android:textColor="#888899"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
